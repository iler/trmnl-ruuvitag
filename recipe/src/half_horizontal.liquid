{%- comment -%}
  Top or bottom half of a stacked mashup: four priority sensors as lines.
  Which four is the installer's call — `featured` is ordered by the priority
  field, so this shows the ones they named first.
{%- endcomment -%}

{%- if fault != '' -%}
  {% render 'notice', headline: 'Ruuvi', detail: fault %}
{%- else -%}
  <div class="layout layout--col">
    <span class="title title--small">Indoor sensors</span>
    <div class="flex flex--col gap--small">
      {%- for sensor in featured limit: 4 -%}
        {% render 'sensor_line', sensor: sensor, with_humidity: true %}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

<div class="title_bar">
  <span class="title">Ruuvi</span>
  <span class="instance">{{ updated_at }}</span>
</div>
