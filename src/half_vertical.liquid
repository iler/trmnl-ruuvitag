{%- comment -%}
  Left or right half of a side-by-side mashup.

  Below lg the half is about 375x450 and holds six rows. On TRMNL X it is
  roughly 500x750, which takes two columns of the full screen's cards — the
  compact version stretched to that width looked lost.

  A portrait X halves that width instead of the height: 375x1010, one column
  of cards about 355x155 each. `wide` is what makes a card that short fit,
  by moving its name up beside the hero.
{%- endcomment -%}

{%- if fault != '' -%}
  {% render 'notice', headline: 'Ruuvi', detail: fault %}
{%- else -%}
  <div class="layout layout--col lg:hidden">
    <span class="title title--small">Indoor sensors</span>
    <div class="flex flex--col gap--small stretch-x">
      {%- for sensor in featured limit: 6 -%}
        {% render 'sensor_row', sensor: sensor %}
      {%- endfor -%}
    </div>
  </div>

  <div class="layout layout--col hidden lg:flex ruuvi">
    <div class="grid grid--cols-2 portrait:grid--cols-1 gap--small ruuvi__grid">
      {%- for sensor in featured limit: 6 -%}
        {%- assign rank_label = forloop.index | prepend: '0' -%}
        {% render 'sensor_card', sensor: sensor, rank: forloop.index, rank_label: rank_label, wide: true %}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

<div class="title_bar">
  <span class="title">Ruuvi</span>
  <span class="instance">{{ updated_at }}</span>
</div>
