<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Test overrides are duplicated as both <server> and <env> with
            force="true". Why both:
              - Vlucas/phpdotenv (which backs Laravel's env() helper) reads
                $_SERVER before $_ENV. Without <server>, .env's empty-string
                placeholders for TRMNL_WEBHOOK_URL etc. — and the empty
                APP_KEY from docker-compose.yml when not running via op run —
                would win over a phpunit <env>-only entry.
              - <env> mirrors keep consumers reading $_ENV directly in sync.
        -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_KEY" value="base64:zZBR8VfgY3i8gXrCqYJjMVKfTuFNOFnXl5cKWxYqOEM=" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <server name="RUUVI_API_TOKEN" value="test-token" force="true"/>
        <server name="TRMNL_DATA_STRATEGY" value="webhook" force="true"/>
        <server name="TRMNL_WEBHOOK_URL" value="https://trmnl.test/webhook" force="true"/>

        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:zZBR8VfgY3i8gXrCqYJjMVKfTuFNOFnXl5cKWxYqOEM=" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <env name="RUUVI_API_TOKEN" value="test-token" force="true"/>
        <env name="TRMNL_DATA_STRATEGY" value="webhook" force="true"/>
        <env name="TRMNL_WEBHOOK_URL" value="https://trmnl.test/webhook" force="true"/>
    </php>
</phpunit>
