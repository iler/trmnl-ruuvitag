# Test environment.
#
# Loaded by Laravel when APP_ENV=testing (which phpunit.xml sets at the
# start of the test run). This file's values are loaded *before* phpunit's
# <env> blocks are evaluated, which sidesteps an ordering issue where
# .env's empty TRMNL_WEBHOOK_URL etc. would otherwise win over phpunit's
# placeholders.

APP_NAME=trmnl-ruuvi
APP_ENV=testing
APP_KEY=base64:zZBR8VfgY3i8gXrCqYJjMVKfTuFNOFnXl5cKWxYqOEM=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=array

TRMNL_PLUGIN_TYPE=private
TRMNL_DATA_STRATEGY=webhook
TRMNL_WEBHOOK_URL=https://trmnl.test/webhook

RUUVI_API_TOKEN=test-token
RUUVI_API_BASE=https://network.ruuvi.com
RUUVI_DISPLAY_TZ=Europe/Helsinki
RUUVI_CACHE_TTL=300
RUUVI_STALE_AFTER=1800

NIGHTWATCH_ENABLED=false
